        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"category\": {\n      \"type\": \"string\",\n      \"description\": \"Classify into: Billing, Technical Support, Account Management, or Shipping/Logistics.\"\n    },\n    \"priority\": {\n      \"type\": \"string\",\n      \"description\": \"Output 'High' if the user mentions immediate deadlines, vacations, or system outages. Otherwise output 'Normal'.\"\n    },\n    \"urgency_reason\": {\n      \"type\": \"string\",\n      \"description\": \"Brief, 1-sentence reason explaining why this priority was chosen.\"\n    },\n    \"order_id\": {\n      \"type\": \"string\",\n      \"description\": \"Extract any 4-digit order numbers mentioned. If none are found, output 'None'.\"\n    }\n  },\n  \"required\": [\n    \"category\",\n    \"priority\",\n    \"urgency_reason\",\n    \"order_id\"\n  ]\n}"
      },
