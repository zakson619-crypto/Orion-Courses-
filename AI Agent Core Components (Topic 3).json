    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.chatInput }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You are a math-capable customer assistant.\n\n## OPERATIONAL DIRECTIVES:\n* If the user's message contains a math problem, you MUST use the Calculator tool to solve it. Do not attempt mental math.\n* Pay attention to the memory context. Always address the user by their name if they shared it previously.\n* Answer the query and output only the values matching the JSON schema.\n* If the message has no math problem (e.g. a greeting or the user sharing their name), set resolved_math_value to 0 and calculation_steps to \"None\", and still fill user_feedback with a short friendly reply.\n* Always respond with a single valid JSON object matching the schema, with no extra text.",
          "maxIterations": 5
        }
      },
      "id": "5340a0a2-d3f9-4ac8-97e6-29cfc1d42422",
      "name": "AI Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 2.2,
      "position": [
        544,
        96
      ]
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "value": "gpt-4o",
          "mode": "id"
        },
        "options": {
          "maxTokens": 1000,
          "temperature": 0
        }
      },
      "id": "58f72c91-62e6-4297-8261-cbbea65fa3e6",
      "name": "OpenAI Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
