      "name": "Calculator",
      "type": "@n8n/n8n-nodes-langchain.toolCalculator",
      "typeVersion": 1,
      "position": [
        752,
        368
      ]
    },
    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"resolved_math_value\": {\n      \"type\": \"number\",\n      \"description\": \"The final calculated number (integer or float). If the message has no math problem, output 0.\"\n    },\n    \"calculation_steps\": {\n      \"type\": \"string\",\n      \"description\": \"Briefly describe the calculations performed (e.g., \\\"15 - 3 + 5\\\"). If no math was needed, output \\\"None\\\".\"\n    },\n    \"user_feedback\": {\n      \"type\": \"string\",\n      \"description\": \"A short, friendly sentence addressing the user by their name (e.g., \\\"Here are your apples, John.\\\").\"\n    }\n  },\n  \"required\": [\n    \"user_feedback\"\n  ]\n}"
      },
