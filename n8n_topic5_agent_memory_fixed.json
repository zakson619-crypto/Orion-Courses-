      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [120, 240],
      "credentials": {
        "openAiApi": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL_ID",
          "name": "OpenAI account"
        }
      },
      "notes": "Step 1: LLM, Temperature 0.0. If you change the model to gpt-5, o1, o3 or o4, REMOVE the Temperature option because those models reject it."
