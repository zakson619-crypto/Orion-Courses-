      "parameters": {
        "jsCode": "const staticData = $getWorkflowStaticData('global');\n\nstaticData.processedTransactions =\n  staticData.processedTransactions || [];\n\nconst body = $input.item.json.body || $input.item.json;\nconst transactionId = String(body.transactionId || '').trim();\n\nif (!transactionId) {\n  return {\n    json: {\n      isDuplicate: false,\n      hasId: false,\n      payload: body,\n      errorMsg: 'Missing required transactionId'\n    }\n  };\n}\n\nconst isDuplicate =\n  staticData.processedTransactions.includes(transactionId);\n\nif (!isDuplicate) {\n  staticData.processedTransactions.push(transactionId);\n\n  if (staticData.processedTransactions.length > 500) {\n    staticData.processedTransactions.shift();\n  }\n}\n\nreturn {\n  json: {\n    transactionId,\n    isDuplicate,\n    hasId: true,\n    payload: body\n  }\n};"
      },
