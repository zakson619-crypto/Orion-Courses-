      ],
      "id": "bdf8cd1e-e995-4bf6-8416-9ba097f97f18",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "jsCode": "const payload = $json.payload || {};\nconst errors = [];\n\nconst emailRegex = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\n\nif (\n  !payload.customerEmail ||\n  !emailRegex.test(payload.customerEmail)\n) {\n  errors.push(\"Invalid or missing 'customerEmail'\");\n}\n\nconst amount = Number(payload.amount);\n\nif (!Number.isFinite(amount) || amount <= 0) {\n  errors.push(\n    \"Field 'amount' must be a positive number greater than 0\"\n  );\n}\n\nconst currencyRegex = /^[A-Z]{3}$/;\n\nif (\n  !payload.currency ||\n  !currencyRegex.test(payload.currency)\n) {\n  errors.push(\n    \"Field 'currency' must be a valid 3-letter uppercase ISO code\"\n  );\n}\n\nconst isValid = errors.length === 0;\n\nreturn {\n  json: {\n    transactionId: $json.transactionId,\n    isValid,\n    validationErrors: errors,\n    sanitizedPayload: {\n      transactionId: $json.transactionId,\n      customerEmail: String(\n        payload.customerEmail || ''\n      ).toLowerCase().trim(),\n      amount,\n      currency: String(\n        payload.currency || ''\n      ).toUpperCase().trim(),\n      description:\n        payload.description || 'Standard Order Charge'\n    }\n  }\n};"
      },
